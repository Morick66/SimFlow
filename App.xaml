<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="SimFlow.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SimFlow"
    xmlns:converters="using:SimFlow.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- SimFlow Design Tokens：主题颜色、字体层级、卡片/徽章/按钮统一样式（2026-09-17 重构）。 -->
                <ResourceDictionary Source="Styles/DesignTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:HexBrushConverter x:Key="HexBrushConverter" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>