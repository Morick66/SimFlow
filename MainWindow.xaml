<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SimFlow.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:SimFlow.ViewModels"
    xmlns:views="using:SimFlow.Views"
    xmlns:models="using:SimFlow.Models"
    mc:Ignorable="d"
    Title="SimFlow">

    <Grid x:Name="RootGrid" Background="{ThemeResource SimFlowPageBrush}" DataContext="{x:Bind ViewModel}">
        <!-- 窄窗口自动把导航收成图标栏，为右侧详情栏让出空间（此前窗口 1536 在小屏幕上把详情顶出屏幕外） -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                    <VisualState.Setters><Setter Target="MainNavigation.PaneDisplayMode" Value="LeftCompact" /></VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1200" /></VisualState.StateTriggers>
                    <VisualState.Setters><Setter Target="MainNavigation.PaneDisplayMode" Value="Left" /></VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.Resources>
            <!-- 项目数据库式列表行：收藏 | 名称(ID/软件) | 需求人 | 状态(版本) | 更新时间 -->
            <DataTemplate x:Key="ProjectRowTemplate" x:DataType="viewModels:ProjectCardViewModel">
                <Grid Padding="14,10" ColumnSpacing="10" MinHeight="76">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /><ColumnDefinition Width="104" /><ColumnDefinition Width="104" /><ColumnDefinition Width="122" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="{x:Bind FavoriteGlyph}" Foreground="{Binding FavoriteColor, Converter={StaticResource HexBrushConverter}}" FontSize="15" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Width="56" Height="56" CornerRadius="8" Background="{ThemeResource SimFlowSurfaceSubtleBrush}" VerticalAlignment="Center">
                        <!-- 只渲染一张图：占位图与封面叠放时，卡片变淡会让下面那张透出来（见 DisplaySource）。 -->
                        <Image Source="{x:Bind DisplaySource, Mode=OneWay}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Name}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource SimFlowTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind ProjectCode}" FontSize="12" Foreground="{ThemeResource SimFlowMutedBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind SoftwareText}" FontSize="12" Foreground="{ThemeResource SimFlowPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{x:Bind RequesterText}" FontSize="13" Foreground="{ThemeResource SimFlowTextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="6,0" />
                    <StackPanel Grid.Column="4" Spacing="4" VerticalAlignment="Center" Margin="6,0">
                        <Border Background="{Binding StatusBackground, Converter={StaticResource HexBrushConverter}}" CornerRadius="6" Padding="7,2" HorizontalAlignment="Left">
                            <TextBlock Text="{x:Bind StatusText}" FontSize="11" Foreground="{Binding StatusForeground, Converter={StaticResource HexBrushConverter}}" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="{x:Bind CurrentVersion}" FontSize="11" Foreground="{ThemeResource SimFlowMutedBrush}" />
                        <TextBlock Text="{x:Bind SimulationTypeText}" FontSize="11" Foreground="{ThemeResource SimFlowTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="5" Spacing="4" VerticalAlignment="Center" Margin="6,0">
                        <TextBlock Foreground="{ThemeResource SimFlowMutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis"><Run Text="更新 " /><Run Text="{x:Bind UpdatedText}" /></TextBlock>
                        <TextBlock Text="{x:Bind MetadataStateText}" Foreground="#A85A00" FontSize="11" Visibility="{Binding IsMetadataPending, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Text="{x:Bind LocationStateText}" Foreground="#B42318" FontSize="11" Visibility="{Binding HasLocationWarning, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <!-- 点击与拖拽分离：整卡负责点击，右上角握把负责拖动，避免拖拽手势吞掉 ItemClick。 -->
            <DataTemplate x:Key="KanbanCardTemplate" x:DataType="viewModels:ProjectCardViewModel">
                <!-- 看板拖动完全自绘：握把按下后由 PointerPressed 捕获指针，PointerMoved 驱动根布局的
                     CardGhostLayer（浮动副本）跟随，位移超过阈值才进入拖动并高亮目标列，松开时执行状态切换。
                     原卡片不改外形、只变淡，全程只有副本一个对象在动。 -->
                <Grid Opacity="{x:Bind CardOpacity, Mode=OneWay}"
                      PointerMoved="KanbanCard_PointerMoved"
                      PointerReleased="KanbanCard_PointerReleased"
                      PointerCanceled="KanbanCard_PointerCanceled"
                      PointerCaptureLost="KanbanCard_PointerCaptureLost">
                    <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource SimFlowTextPrimaryBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <FontIcon Grid.Column="1" Glyph="{x:Bind FavoriteGlyph}" Foreground="{Binding FavoriteColor, Converter={StaticResource HexBrushConverter}}" FontSize="14" VerticalAlignment="Center" />
                                <!-- 握把只负责拖动：按下即捕获指针（CapturePointer），因此指针离开握把甚至离开卡片
                                     仍能继续收到 PointerMoved；整卡负责 ItemClick，两者互不干扰。 -->
                                <!-- 非拖拽入口：键盘和触控用户可直接打开与详情页相同的状态菜单。 -->
                                <Button Grid.Column="2" Width="28" Height="28" MinWidth="0" Padding="4"
                                        Click="ChangeStatus_Click"
                                        IsEnabled="{x:Bind IsLocationAvailable}"
                                        Background="Transparent" BorderThickness="0"
                                        ToolTipService.ToolTip="修改项目状态"
                                        AutomationProperties.Name="修改项目状态">
                                    <FontIcon Glyph="&#xE713;" Foreground="{ThemeResource SimFlowMutedBrush}" FontSize="13" />
                                </Button>
                                <!-- 鼠标拖动入口；离线项目禁用命中，状态仍可由旁边的按钮发现。 -->
                                <FontIcon Grid.Column="3" Glyph="&#xE784;" Foreground="{ThemeResource SimFlowMutedBrush}" FontSize="14"
                                          VerticalAlignment="Center"
                                          PointerPressed="KanbanHandle_PointerPressed"
                                          IsHitTestVisible="{x:Bind IsLocationAvailable}"
                                          AutomationProperties.Name="拖动修改项目状态"
                                          ToolTipService.ToolTip="按住拖到其他列修改状态" />
                            </Grid>
                            <TextBlock Text="{x:Bind ProjectCode}" FontSize="11" Foreground="{ThemeResource SimFlowMutedBrush}" />
                            <!-- 封面用固定宽高比而不是固定高度：看板四列等分，窗口越宽卡片越宽，
                                 固定高度会变成又扁又长的横条（宽窗口下接近 4:1）。这里的初始高度只是
                                 为了首次布局不跳，实际高度由 KanbanCover_SizeChanged 按宽度算出来。 -->
                            <Border Height="88" CornerRadius="8" Background="{ThemeResource SimFlowSurfaceSubtleBrush}"
                                    SizeChanged="KanbanCover_SizeChanged">
                                <Image Source="{x:Bind DisplaySource, Mode=OneWay}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Background="{Binding StatusBackground, Converter={StaticResource HexBrushConverter}}" CornerRadius="6" Padding="7,2"><TextBlock Text="{x:Bind StatusText}" FontSize="11" Foreground="{Binding StatusForeground, Converter={StaticResource HexBrushConverter}}" FontWeight="SemiBold" /></Border>
                                <TextBlock Text="{x:Bind CurrentVersion}" FontSize="11" Foreground="{ThemeResource SimFlowMutedBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind WaitText}" FontSize="11" Foreground="#A85A00" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Visibility="{Binding HasWaitText, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                            <!-- 软件与需求人合并为一行：左侧软件(可截断)、右侧需求人(次要文字)。 -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind SoftwareText}" FontSize="11" Foreground="{ThemeResource SimFlowPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind RequesterText}" FontSize="11" Foreground="{ThemeResource SimFlowMutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="96" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="{x:Bind LocationStateText}" FontSize="11" Foreground="#B42318" TextWrapping="Wrap" Visibility="{Binding HasLocationWarning, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </DataTemplate>
            <Style x:Key="KanbanItemContainerStyle" TargetType="ListViewItem">
                <!-- 这里的几何必须与卡片本体完全一致，否则平台的悬浮/选中背景会从卡片盖不住的地方露出来：
                     它按"列表项盒子 + 本属性的圆角"绘制，而卡片是 12px 圆角。曾经列表项用 8px、竖直留白又多
                     3px，结果卡片四个角各露出一小块极淡的直角（看起来像阴影）。
                     现在圆角统一 12px，3px 竖直留白从模板移到这里的 Margin（外观间距不变），
                     两者盒子重合，悬浮背景被卡片完整遮住。 -->
                <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="4,5" /><Setter Property="CornerRadius" Value="12" />
            </Style>
            <!-- 侧边栏导航项统一样式：更高、圆角选中（隐式样式，作用于本窗口内全部 NavigationViewItem）。 -->
            <Style TargetType="NavigationViewItem">
                <Setter Property="MinHeight" Value="46" />
                <Setter Property="Margin" Value="8,2" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontSize" Value="14" />
            </Style>
            <!-- 标签管理页的行 -->
            <DataTemplate x:Key="TagRowTemplate" x:DataType="viewModels:TagSummaryViewModel">
                <Grid Padding="12,10" ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" Foreground="{ThemeResource SimFlowTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind CountText}" FontSize="12" Foreground="{ThemeResource SimFlowMutedBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="重命名" Click="TagRename_Click" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Content="合并" Click="TagMerge_Click" VerticalAlignment="Center" Margin="6,0,0,0" />
                    <Button Grid.Column="3" Content="删除" Click="TagDelete_Click" VerticalAlignment="Center" Margin="6,0,0,0" IsEnabled="{x:Bind CanDelete}" />
                </Grid>
            </DataTemplate>
            <!-- 软件标签只记录名称，供项目选择与统计使用。 -->
            <DataTemplate x:Key="SoftwareLabelRowTemplate" x:DataType="models:SoftwareConfiguration">
                <Grid Padding="12,10" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource SimFlowSurfaceSubtleBrush}">
                        <TextBlock Text="{x:Bind Initial}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource SimFlowPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontWeight="SemiBold" Foreground="{ThemeResource SimFlowTextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Content="编辑" Click="SoftwareEdit_Click" VerticalAlignment="Center" FontSize="12" />
                    <Button Grid.Column="3" Content="移除候选" Click="SoftwareDelete_Click" VerticalAlignment="Center" FontSize="12" />
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <NavigationView x:Name="MainNavigation"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="False"
                        IsPaneOpen="True"
                        PaneDisplayMode="Left"
                        OpenPaneLength="200"
                        CompactPaneLength="60"
                        SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.PaneHeader>
                <Grid Height="80" Padding="20,14,14,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="12" VerticalAlignment="Center">
                        <Image Source="ms-appx:///Assets/Square150x150Logo.scale-200.png" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="SimFlow" FontSize="19" FontWeight="SemiBold" Foreground="{ThemeResource SimFlowTextPrimaryBrush}" />
                        <TextBlock Text="让仿真更高效" FontSize="12" Foreground="{ThemeResource SimFlowMutedBrush}" />
                    </StackPanel>
                </Grid>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <!-- 一级导航只有五项：未开始/进行中/等待中/已完成/已归档不再各占一个入口，
                     筛选改为“所有项目”页内的筛选条（见 ProjectListPanel）；归档仍作为存储状态保留。 -->
                <NavigationViewItem Content="首页" Tag="home" IsSelected="True"><NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="所有项目" Tag="all"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Tag="favorite">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE735;" /></NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="收藏" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Background="{ThemeResource SimFlowSurfaceSubtleBrush}" CornerRadius="9" Padding="7,1"><TextBlock Text="{x:Bind ViewModel.FavoriteProjectCount, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource SimFlowMutedBrush}" /></Border>
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                <NavigationViewItem Content="统计分析" Tag="statistics"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D2;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItemSeparator />
                <!-- 设置：独立页面（Phase 7），点击直接进入完整设置页。 -->
                <NavigationViewItem Content="设置" Tag="settings"><NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- 内容根：尺寸变化时按可用宽度重算“双栏 / 窄窗口独立详情页”布局（SF-010）。 -->
            <Grid x:Name="ContentRoot" SizeChanged="ContentRoot_SizeChanged">
                <Grid.RowDefinitions><RowDefinition Height="78" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Grid.Row="0" Padding="24,18,24,12" ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <!-- 窄窗口独立详情页的返回按钮：仅在窄窗口且已选中项目时可见（由 UpdateResponsiveLayout 控制）。 -->
                    <Button x:Name="BackButton" Click="Back_Click" Visibility="Collapsed" MinWidth="76" Height="46" VerticalAlignment="Center" Style="{StaticResource SecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72B;" FontSize="15" /><TextBlock Text="返回" FontSize="15" /></StackPanel>
                    </Button>
                    <Grid Grid.Column="1">
                        <TextBox x:Name="SearchBox" Height="46" CornerRadius="9" VerticalAlignment="Center" Padding="14,10"
                                 PlaceholderText="搜索项目名称、关键词、备注..." TextChanged="SearchBox_TextChanged">
                            <TextBox.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="K" Invoked="SearchShortcut_Invoked" />
                            </TextBox.KeyboardAccelerators>
                        </TextBox>
                        <TextBlock x:Name="SearchHintText" IsHitTestVisible="False" Text="Ctrl+K" FontSize="11"
                                   Foreground="{ThemeResource SimFlowMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" />
                    </Grid>
                    <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Height="46" CornerRadius="9" Click="NewProject_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="16" Foreground="White" /><TextBlock Text="新建项目" FontSize="15" Foreground="White" /></StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="1" Padding="24,0,24,16" ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="ListColumn" Width="*" MinWidth="440" /><ColumnDefinition x:Name="DetailColumn" Width="360" /></Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <!-- 统计卡片只在首页显示，其余页面不占这行 -->
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition x:Name="SectionHeaderRow" Height="56" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <ItemsControl x:Name="StatsRow" ItemsSource="{x:Bind ViewModel.Stats, Mode=OneWay}" Height="120">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:StatCardViewModel">
                                    <!-- Button 原生支持 Tab、Enter、Space 与 UI Automation；内层卡片保留原视觉。 -->
                                    <Button Width="164" Height="106" Margin="0,0,16,0" Padding="0"
                                            Background="Transparent" BorderThickness="0"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                            Click="StatCard_Click"
                                            AutomationProperties.Name="{x:Bind AutomationName}">
                                        <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <Border Width="44" Height="44" CornerRadius="10" Background="{Binding IconBackground, Converter={StaticResource HexBrushConverter}}">
                                                    <FontIcon Glyph="{x:Bind IconGlyph}" Foreground="{Binding AccentColor, Converter={StaticResource HexBrushConverter}}" FontSize="22" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Title}" FontSize="12" Foreground="{ThemeResource SimFlowTextSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind Count}" FontSize="27" FontWeight="SemiBold" Foreground="{ThemeResource SimFlowTextPrimaryBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid x:Name="SectionHeader" Grid.Row="1" ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.CurrentSectionTitle, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource SimFlowTextPrimaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.ProjectCountText, Mode=OneWay}" FontSize="14" Foreground="{ThemeResource SimFlowMutedBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <ComboBox x:Name="SortCombo" Grid.Column="1" Width="132" SelectedIndex="0" VerticalAlignment="Center" SelectionChanged="SortCombo_SelectionChanged"><ComboBoxItem Content="最近更新" /><ComboBoxItem Content="创建时间" /><ComboBoxItem Content="项目名称" /></ComboBox>
                        </Grid>

                        <Grid Grid.Row="2">
                            <!-- 首页看板：拖动完全自绘（不经过系统拖放）。按住右上角握把由 PointerMoved 驱动浮动副本，
                                 目标列由四列矩形自行命中判定并高亮，松开时执行状态切换；整卡保留 ItemClick 负责点开详情。
                                 四列的 ListView 一律隐藏覆盖式滚动条：它绘制在卡片之上，会在卡片右边缘、尤其是圆角外侧
                                 留下两段很小的深色直角（看起来像阴影，其实是滚动条本身）；隐藏后仍可滚轮/拖动滚动。 -->
                            <Grid x:Name="KanbanBoard" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="NotStartedColumn" Background="{ThemeResource SimFlowSurfaceSubtleBrush}" CornerRadius="12" Padding="8" BorderThickness="2" BorderBrush="Transparent" Tag="notstarted">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                        <Grid Margin="4,4,4,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="未开始" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource SimFlowTextPrimaryBrush}" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" Style="{StaticResource BadgeBorderStyle}" Background="{ThemeResource SimFlowCardBrush}"><TextBlock Text="{x:Bind ViewModel.NotStartedProjectCount, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SimFlowTextSecondaryBrush}" /></Border>
                                        </Grid>
                                        <ListView x:Name="NotStartedList" Grid.Row="1"
                                                  ItemsSource="{x:Bind ViewModel.NotStartedProjects, Mode=OneWay}"
                                                  ItemTemplate="{StaticResource KanbanCardTemplate}"
                                                  ItemContainerStyle="{StaticResource KanbanItemContainerStyle}"
                                                  ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                                  SelectionMode="Single"
                                                  IsItemClickEnabled="True"
                                                  ItemClick="KanbanCard_ItemClick"
                                                  />
                                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4" Visibility="{Binding NotStartedEmpty, Converter={StaticResource BoolToVisibilityConverter}}" IsHitTestVisible="False">
                                            <FontIcon Glyph="&#xE823;" FontSize="22" Foreground="{ThemeResource SimFlowMutedBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="暂无未开始项目" FontSize="12" Foreground="{ThemeResource SimFlowMutedBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border x:Name="ActiveColumn" Grid.Column="1" Background="{ThemeResource SimFlowSurfaceSubtleBrush}" CornerRadius="12" Padding="8" BorderThickness="2" BorderBrush="Transparent" Tag="active">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                        <Grid Margin="4,4,4,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="进行中" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource SimFlowTextPrimaryBrush}" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" Style="{StaticResource BadgeBorderStyle}" Background="#E8F1FF"><TextBlock Text="{x:Bind ViewModel.ActiveProjectCount, Mode=OneWay}" FontSize="12" Foreground="#2563EB" /></Border>
                                        </Grid>
                                        <ListView x:Name="ActiveList" Grid.Row="1"
                                                  ItemsSource="{x:Bind ViewModel.ActiveProjects, Mode=OneWay}"
                                                  ItemTemplate="{StaticResource KanbanCardTemplate}"
                                                  ItemContainerStyle="{StaticResource KanbanItemContainerStyle}"
                                                  ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                                  SelectionMode="Single"
                                                  IsItemClickEnabled="True"
                                                  ItemClick="KanbanCard_ItemClick" />
                                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4" Visibility="{Binding ActiveEmpty, Converter={StaticResource BoolToVisibilityConverter}}" IsHitTestVisible="False">
                                            <FontIcon Glyph="&#xE768;" FontSize="22" Foreground="{ThemeResource SimFlowMutedBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="暂无进行中项目" FontSize="12" Foreground="{ThemeResource SimFlowMutedBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border x:Name="WaitingColumn" Grid.Column="2" Background="{ThemeResource SimFlowSurfaceSubtleBrush}" CornerRadius="12" Padding="8" BorderThickness="2" BorderBrush="Transparent" Tag="waiting">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                        <Grid Margin="4,4,4,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="等待中" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource SimFlowTextPrimaryBrush}" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" Style="{StaticResource BadgeBorderStyle}" Background="#FFF3DA"><TextBlock Text="{x:Bind ViewModel.WaitingProjectCount, Mode=OneWay}" FontSize="12" Foreground="#B4740A" /></Border>
                                        </Grid>
                                        <ListView x:Name="WaitingList" Grid.Row="1"
                                                  ItemsSource="{x:Bind ViewModel.WaitingProjects, Mode=OneWay}"
                                                  ItemTemplate="{StaticResource KanbanCardTemplate}"
                                                  ItemContainerStyle="{StaticResource KanbanItemContainerStyle}"
                                                  ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                                  SelectionMode="Single"
                                                  IsItemClickEnabled="True"
                                                  ItemClick="KanbanCard_ItemClick" />
                                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4" Visibility="{Binding WaitingEmpty, Converter={StaticResource BoolToVisibilityConverter}}" IsHitTestVisible="False">
                                            <FontIcon Glyph="&#xE823;" FontSize="22" Foreground="{ThemeResource SimFlowMutedBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="暂无等待中项目" FontSize="12" Foreground="{ThemeResource SimFlowMutedBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border x:Name="CompletedColumn" Grid.Column="3" Background="{ThemeResource SimFlowSurfaceSubtleBrush}" CornerRadius="12" Padding="8" BorderThickness="2" BorderBrush="Transparent" Tag="completed">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                        <Grid Margin="4,4,4,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="已完成" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource SimFlowTextPrimaryBrush}" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" Style="{StaticResource BadgeBorderStyle}" Background="#E1F7EC"><TextBlock Text="{x:Bind ViewModel.CompletedProjectCount, Mode=OneWay}" FontSize="12" Foreground="#16A34A" /></Border>
                                        </Grid>
                                        <ListView x:Name="CompletedList" Grid.Row="1"
                                                  ItemsSource="{x:Bind ViewModel.CompletedProjects, Mode=OneWay}"
                                                  ItemTemplate="{StaticResource KanbanCardTemplate}"
                                                  ItemContainerStyle="{StaticResource KanbanItemContainerStyle}"
                                                  ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                                  SelectionMode="Single"
                                                  IsItemClickEnabled="True"
                                                  ItemClick="KanbanCard_ItemClick" />
                                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4" Visibility="{Binding CompletedEmpty, Converter={StaticResource BoolToVisibilityConverter}}" IsHitTestVisible="False">
                                            <FontIcon Glyph="&#xE73E;" FontSize="22" Foreground="{ThemeResource SimFlowMutedBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="暂无已完成项目" FontSize="12" Foreground="{ThemeResource SimFlowMutedBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- 主题筛选页：完整列表 -->
                            <Border x:Name="ProjectListPanel" Style="{StaticResource CardBorderStyle}" Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <!-- 筛选胶囊随可用宽度换行，保留原有单选组与事件。 -->
                                    <VariableSizedWrapGrid Grid.Row="0" Orientation="Horizontal" ItemWidth="100" ItemHeight="44" Margin="16,14,8,4">
                                        <RadioButton x:Name="ListFilterAll" Content="全部" Tag="all" GroupName="ListFilter" Style="{StaticResource FilterChipRadioStyle}" Checked="ListFilter_Checked" />
                                        <RadioButton x:Name="ListFilterNotStarted" Content="未开始" Tag="notstarted" GroupName="ListFilter" Style="{StaticResource FilterChipRadioStyle}" Checked="ListFilter_Checked" />
                                        <RadioButton x:Name="ListFilterActive" Content="进行中" Tag="active" GroupName="ListFilter" Style="{StaticResource FilterChipRadioStyle}" Checked="ListFilter_Checked" />
                                        <RadioButton x:Name="ListFilterWaiting" Content="等待中" Tag="waiting" GroupName="ListFilter" Style="{StaticResource FilterChipRadioStyle}" Checked="ListFilter_Checked" />
                                        <RadioButton x:Name="ListFilterCompleted" Content="已完成" Tag="completed" GroupName="ListFilter" Style="{StaticResource FilterChipRadioStyle}" Checked="ListFilter_Checked" />
                                        <RadioButton x:Name="ListFilterArchived" Content="已归档" Tag="archived" GroupName="ListFilter" Style="{StaticResource FilterChipRadioStyle}" Checked="ListFilter_Checked" />
                                        <RadioButton x:Name="ListFilterFavorite" Content="收藏" Tag="favorite" GroupName="ListFilter" Style="{StaticResource FilterChipRadioStyle}" Checked="ListFilter_Checked" />
                                    </VariableSizedWrapGrid>
                                    <Grid Grid.Row="1">
                                        <ListView x:Name="ProjectList" ItemsSource="{x:Bind ViewModel.Projects, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedProject, Mode=OneWay}" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="ProjectList_ItemClick" ItemTemplate="{StaticResource ProjectRowTemplate}">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="88" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Margin" Value="5,2" /></Style>
                                            </ListView.ItemContainerStyle>
                                        </ListView>
                                        <StackPanel x:Name="ProjectListEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="40" Foreground="{ThemeResource SimFlowMutedBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="还没有符合条件的项目" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource SimFlowTextPrimaryBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="新建项目或调整筛选条件后，项目会显示在这里。" FontSize="13" Foreground="{ThemeResource SimFlowMutedBrush}" HorizontalAlignment="Center" />
                                            <Button Content="新建第一个项目" Style="{StaticResource PrimaryButtonStyle}" Click="NewProject_Click" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- 统计分析页：独立页面，自带标题与时间范围，纵向滚动。 -->
                            <views:StatisticsPage x:Name="StatisticsPanel" Visibility="Collapsed" />

                            <!-- 设置页（P8）：左中为主内容(有限宽滚动)，右侧 DetailColumn 由 SettingsNavPane 承载设置导航。 -->
                            <Border x:Name="SettingsPanel" Style="{StaticResource CardBorderStyle}" CornerRadius="12" Padding="0">
                                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Padding="24,20,24,28" Spacing="18" MaxWidth="840" HorizontalAlignment="Center">
                                        <!-- 常规 -->
                                        <StackPanel x:Name="SettingsGeneralSection" Spacing="12">
                                            <TextBlock Text="常规" Style="{StaticResource SectionTitleTextStyle}" />
                                            <TextBlock Text="主题跟随 Windows 深浅色模式；所有界面颜色使用主题资源，无需单独设置。" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
                                            <TextBlock Text="运行数据（数据库、配置、日志）位于 %LOCALAPPDATA%\SimFlow，与源码完全分离。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                            <Border Style="{StaticResource CardBorderStyle}" CornerRadius="10" Padding="14">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="项目占位图" Style="{StaticResource CardTitleTextStyle}" />
                                                    <TextBlock Text="项目未设置封面时，卡片和详情都使用这张图；留空则使用内置占位图。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <TextBox x:Name="SettingsPlaceholderBox" PlaceholderText="留空使用内置占位图" Style="{StaticResource SimFlowTextBoxStyle}" />
                                                        <Button Grid.Column="1" Content="选择图片…" Click="SettingsBrowsePlaceholder_Click" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom" />
                                                        <Button Grid.Column="2" Content="清除" Click="SettingsClearPlaceholder_Click" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom" />
                                                        <Button Grid.Column="3" Content="保存常规" Click="SaveGeneralSettings_Click" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource CardBorderStyle}" CornerRadius="10" Padding="14">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="仿真报告模板" Style="{StaticResource CardTitleTextStyle}" />
                                                    <TextBlock Text="点击项目快捷操作中的“仿真报告”后：Delivery 中有且仅有一个 Word 报告时直接打开；没有报告时复制模板；多个报告时提示处理。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <TextBox x:Name="SettingsReportTemplateBox" PlaceholderText="选择 Word 仿真报告模板" Style="{StaticResource SimFlowTextBoxStyle}" />
                                                        <Button Grid.Column="1" Content="选择模板…" Click="SettingsBrowseReportTemplate_Click" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom" />
                                                        <Button Grid.Column="2" Content="清除" Click="SettingsClearReportTemplate_Click" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom" />
                                                        <Button Grid.Column="3" Content="保存模板" Click="SaveReportTemplateSettings_Click" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- 项目目录：每个位置一个 Setting Section（有限宽度，不横跨整页）。 -->
                                        <StackPanel x:Name="SettingsDirectoriesSection" Visibility="Collapsed" Spacing="12">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="项目目录" Style="{StaticResource SectionTitleTextStyle}" />
                                                <TextBlock Text="三个存储位置的根目录；保存后立即生效。本机 Work 为空时不能在本机创建项目。" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Border Style="{StaticResource CardBorderStyle}" CornerRadius="10" Padding="14">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="本机 Work" Style="{StaticResource CardTitleTextStyle}" />
                                                    <TextBlock Text="项目文件存放根目录，用于本机创建与日常管理。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <TextBox x:Name="SettingsLocalWorkBox" PlaceholderText="未设置时无法在本机创建项目" Style="{StaticResource SimFlowTextBoxStyle}" />
                                                        <Button Grid.Column="1" Content="选择目录…" Click="SettingsBrowseLocal_Click" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom" />
                                                        <Button Grid.Column="2" Content="打开" Click="SettingsOpenLocal_Click" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource CardBorderStyle}" CornerRadius="10" Padding="14">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="工作站 Work" Style="{StaticResource CardTitleTextStyle}" />
                                                    <TextBlock Text="工作站共享目录（UNC），迁移目标之一。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <TextBox x:Name="SettingsWorkstationBox" PlaceholderText="\\WORKSTATION\Simulation\Work" Style="{StaticResource SimFlowTextBoxStyle}" />
                                                        <Button Grid.Column="1" Content="测试连接" Click="SettingsTestWorkstation_Click" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom" />
                                                        <Button Grid.Column="2" Content="打开" Click="SettingsOpenWorkstation_Click" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource CardBorderStyle}" CornerRadius="10" Padding="14">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="工作站 Archive" Style="{StaticResource CardTitleTextStyle}" />
                                                    <TextBlock Text="归档根目录（UNC），按年/月组织归档项目。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <TextBox x:Name="SettingsArchiveBox" PlaceholderText="\\WORKSTATION\Simulation\Archive" Style="{StaticResource SimFlowTextBoxStyle}" />
                                                        <Button Grid.Column="1" Content="测试连接" Click="SettingsTestArchive_Click" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom" />
                                                        <Button Grid.Column="2" Content="打开" Click="SettingsOpenArchive_Click" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                            <Button Content="保存设置" Style="{StaticResource PrimaryButtonStyle}" Click="SaveSettings_Click" HorizontalAlignment="Left" />
                                        </StackPanel>

                                        <!-- 标签 -->
                                        <StackPanel x:Name="SettingsTagsSection" Visibility="Collapsed" Spacing="10">
                                            <TextBlock Text="标签" Style="{StaticResource SectionTitleTextStyle}" />
                                            <TextBlock Text="重命名、合并，或删除未被任何项目使用的标签。项目内的标签用 chip 编辑器直接添加。" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
                                            <ListView ItemsSource="{x:Bind ViewModel.Tags, Mode=OneWay}" ItemTemplate="{StaticResource TagRowTemplate}" SelectionMode="None" />
                                        </StackPanel>

                                        <!-- 软件标签：维护项目使用的软件名称。 -->
                                        <StackPanel x:Name="SettingsSoftwareSection" Visibility="Collapsed" Spacing="10">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="软件标签" Style="{StaticResource SectionTitleTextStyle}" />
                                                    <TextBlock Text="管理项目使用的软件名称，用于项目标记和软件使用统计。" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Content="＋ 添加软件标签" Click="NewSoftware_Click" VerticalAlignment="Center" />
                                            </Grid>
                                            <ListView ItemsSource="{x:Bind ViewModel.SoftwareList, Mode=OneWay}" ItemTemplate="{StaticResource SoftwareLabelRowTemplate}" SelectionMode="None" />
                                        </StackPanel>

                                        <!-- 迁移与归档 -->
                                        <StackPanel x:Name="SettingsMigrationSection" Visibility="Collapsed" Spacing="10">
                                            <TextBlock Text="迁移与归档" Style="{StaticResource SectionTitleTextStyle}" />
                                            <TextBlock Text="查看未完成的迁移：继续或安全重试、放弃未完成暂存副本、确认清理保留的源目录。归档遵循工作站 Archive 的年/月目录规则。" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
                                            <Button Content="迁移恢复…" Click="MigrationRecovery_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" />
                                        </StackPanel>

                                        <!-- 数据与备份 -->
                                        <StackPanel x:Name="SettingsDataSection" Visibility="Collapsed" Spacing="10">
                                            <TextBlock Text="数据与备份" Style="{StaticResource SectionTitleTextStyle}" />
                                            <TextBlock Text="项目数据库由 SQLite 管理，仅在结构升级时自动备份升级前副本；扫描可导入缺失的项目档案并逐项处理编号冲突。" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
                                            <Button Style="{StaticResource PrimaryButtonStyle}" Content="扫描恢复…" Click="Scan_Click" HorizontalAlignment="Left" />
                                        </StackPanel>

                                        <!-- 帮助：项目目录结构说明（与《SimFlow 项目目录结构规范》一致）。 -->
                                        <StackPanel x:Name="SettingsHelpSection" Visibility="Collapsed" Spacing="12">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="帮助" Style="{StaticResource SectionTitleTextStyle}" />
                                                <TextBlock Text="项目目录结构说明" Style="{StaticResource CardTitleTextStyle}" />
                                                <TextBlock Text="SimFlow 只依赖项目目录里的两个文件：project.json（必需）和 cover.*（可选，封面）。其余目录是给人看的约定，用来保证迁移、归档和版本对比不出错。" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Border Style="{StaticResource CardBorderStyle}" CornerRadius="10" Padding="14" Background="{ThemeResource SimFlowSurfaceSubtleBrush}">
                                                <TextBlock FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" Foreground="{ThemeResource SimFlowTextPrimaryBrush}" Text="SIM_20260917_001\                   项目目录（= 项目编号）&#10;├─ project.json                     项目档案（必需）&#10;├─ cover.png                        可选封面&#10;├─ Documents\                       需求单、图纸、清单等资料&#10;├─ Versions\&#10;│  ├─ V001\                         一个版本 = 一套内容&#10;│  │  ├─ version.json               版本档案&#10;│  │  ├─ 3D_Model\                  SolidWorks、x_t、STEP&#10;│  │  ├─ CAE_Model\                 Adams、ANSYS 等&#10;│  │  ├─ Data\                      输入数据&#10;│  │  └─ Results\                   仿真结果&#10;│  └─ V002\                         与 V001 同构&#10;└─ Delivery\                        对外交付物&#10;   ├─ 仿真分析报告.docx&#10;   ├─ Figures\                      报告用图表&#10;   └─ Animation\                    演示动画" />
                                            </Border>
                                            <Border Style="{StaticResource CardBorderStyle}" CornerRadius="10" Padding="14">
                                                <StackPanel Spacing="10">
                                                    <TextBlock Text="每个目录放什么" Style="{StaticResource CardTitleTextStyle}" />
                                                    <Grid ColumnSpacing="12" RowSpacing="7">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="225" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="project.json / cover.*" FontFamily="Consolas" FontSize="12" Foreground="{ThemeResource SimFlowTextPrimaryBrush}" />
                                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="项目档案与封面。由 SimFlow 维护，请勿手工修改。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Documents\" FontFamily="Consolas" FontSize="12" Foreground="{ThemeResource SimFlowTextPrimaryBrush}" />
                                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="与版本无关的文档：需求单、图纸、零件清单、参考资料、评审记录。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Versions\Vxxx\3D_Model\" FontFamily="Consolas" FontSize="12" Foreground="{ThemeResource SimFlowTextPrimaryBrush}" />
                                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="三维模型：SolidWorks 装配/零件、x_t、STEP 等中间格式。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Versions\Vxxx\CAE_Model\" FontFamily="Consolas" FontSize="12" Foreground="{ThemeResource SimFlowTextPrimaryBrush}" />
                                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="求解器模型：Adams、ANSYS Mechanical / Maxwell、柔性体文件。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Versions\Vxxx\Data\" FontFamily="Consolas" FontSize="12" Foreground="{ThemeResource SimFlowTextPrimaryBrush}" />
                                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="该版本的输入数据：参数表、实测数据、csv / xlsx。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Versions\Vxxx\Results\" FontFamily="Consolas" FontSize="12" Foreground="{ThemeResource SimFlowTextPrimaryBrush}" />
                                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="该版本的仿真结果原始产出：求解器输出、结果数据、过程图表。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Delivery\" FontFamily="Consolas" FontSize="12" Foreground="{ThemeResource SimFlowTextPrimaryBrush}" />
                                                        <TextBlock Grid.Row="6" Grid.Column="1" Text="项目级对外交付物：正式分析报告；Figures 放图表，Animation 放演示动画。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource CardBorderStyle}" CornerRadius="10" Padding="14">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="几条必须遵守的规则" Style="{StaticResource CardTitleTextStyle}" />
                                                    <TextBlock Text="• 一个版本 = 一套自包含内容：V002 不能用符号链接引用 V001，必须物理复制；迁移遇到链接会直接失败。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                                    <TextBlock Text="• 目录里不放占位文件；空目录由程序在迁移/复制时按源结构重建目录来保留，所以不要删掉标准目录（程序只在创建时建一次）。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                                    <TextBlock Text="• project.json 与 version.json 由 SimFlow 维护，手工修改会在下次启动同步时被覆盖。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                                    <TextBlock Text="• 项目目录必须是存储根的直接子目录；归档由 SimFlow 放到 Archive\年\月\ 下，不要手工调整层级。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                                    <TextBlock Text="• 不要在项目内出现第二个 project.json，也不要在项目根放自定义的 cover.* 文件（会被封面逻辑删除）。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                                    <TextBlock Text="• 过程中的东西放版本目录，对外交付的东西放 Delivery；新建版本请用界面上的入口，不要手工建 Versions\Vxxx。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>

                    <Border x:Name="DetailBorder" Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="18,12,18,16">
                        <Grid>
                            <Grid x:Name="DetailPanel" Visibility="Collapsed">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <!-- 详情头部（固定）：标题最多两行完整换行，绝不逐字折行；星标置右上。 -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedProject.Name, Mode=OneWay}" Style="{StaticResource PageTitleTextStyle}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="1" Click="Favorite_Click" ToolTipService.ToolTip="收藏/取消收藏" Style="{StaticResource SecondaryButtonStyle}" Padding="10,8">
                                        <FontIcon Glyph="{x:Bind ViewModel.SelectedProject.FavoriteGlyph, Mode=OneWay}" Foreground="{Binding SelectedProject.FavoriteColor, Converter={StaticResource HexBrushConverter}}" />
                                    </Button>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,4,0,2" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedProject.ProjectCode, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Button x:Name="StatusChangeButton" Grid.Column="1" Click="ChangeStatus_Click" Background="Transparent" BorderThickness="0" Padding="0" MinHeight="0" VerticalAlignment="Center" ToolTipService.ToolTip="点击修改状态" AutomationProperties.Name="修改项目状态">
                                        <Border Background="{Binding SelectedProject.StatusBackground, Converter={StaticResource HexBrushConverter}}" CornerRadius="6" Padding="8,3">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="{x:Bind ViewModel.SelectedProject.StatusText, Mode=OneWay}" FontSize="12" Foreground="{Binding SelectedProject.StatusForeground, Converter={StaticResource HexBrushConverter}}" FontWeight="SemiBold" />
                                                <FontIcon Glyph="&#xE70D;" FontSize="10" Foreground="{Binding SelectedProject.StatusForeground, Converter={StaticResource HexBrushConverter}}" />
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </Grid>
                                <!-- Tab 区域（Grid.Row=2）获得受限高度，各自内容独立滚动，详情栏不再整体溢出。 -->
                                <TabView Grid.Row="2" Margin="-8,6,-8,0" IsAddTabButtonVisible="False" TabWidthMode="SizeToContent">
                                    <TabViewItem Header="概览" IsClosable="False">
                                        <ScrollViewer VerticalScrollBarVisibility="Hidden">
                                            <StackPanel Spacing="16" Padding="8,10,8,20">
                                                <StackPanel Spacing="8">
                                                    <Border Height="190" CornerRadius="10" Background="{ThemeResource SimFlowSurfaceSubtleBrush}"
                                                            PointerEntered="CoverPreview_PointerEntered" PointerExited="CoverPreview_PointerExited">
                                                        <Grid>
                                                            <!-- 只渲染一张图：占位图与封面叠放时，卡片变淡会让下面那张透出来（见 DisplaySource）。 -->
                                                            <Image Source="{x:Bind ViewModel.SelectedProject.DisplaySource, Mode=OneWay}" Stretch="UniformToFill" />
                                                            <!-- 有封面时 Hover 显示的浮动操作（半透明 Surface），默认隐藏。 -->
                                                            <StackPanel x:Name="CoverActionsOverlay" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                       Visibility="Collapsed" Margin="8" Background="#66000000" CornerRadius="6" Padding="4"
                                                                       Orientation="Horizontal" Spacing="4">
                                                                <Button x:Name="SetCoverButton" Click="SetCover_Click" Padding="8,3" FontSize="12">
                                                                    <StackPanel Orientation="Horizontal" Spacing="4"><FontIcon Glyph="&#xE8B7;" FontSize="12" /><TextBlock Text="更换封面" FontSize="12" /></StackPanel>
                                                                </Button>
                                                                <Button x:Name="ClearCoverButton" Click="ClearCover_Click" Padding="8,3" FontSize="12">
                                                                    <StackPanel Orientation="Horizontal" Spacing="4"><FontIcon Glyph="&#xE74D;" FontSize="12" /><TextBlock Text="移除" FontSize="12" /></StackPanel>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="项目描述" Style="{StaticResource CardTitleTextStyle}" />
                                                    <TextBlock Text="{x:Bind ViewModel.SelectedProject.Description, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" LineHeight="22" />
                                                </StackPanel>
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="使用软件" Style="{StaticResource CardTitleTextStyle}" />
                                                    <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedProject.Project.Software, Mode=OneWay}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" /></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#E8F1FF" CornerRadius="7" Padding="9,4" Margin="0,0,6,6">
                                                                    <TextBlock Text="{Binding}" Foreground="#2563EB" FontSize="12" FontWeight="SemiBold" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="项目信息" Style="{StaticResource CardTitleTextStyle}" />
                                                    <Grid RowSpacing="8" ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="88" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                        <TextBlock Text="状态" Style="{StaticResource SecondaryTextStyle}" /><TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedProject.StatusText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource SimFlowTextPrimaryBrush}" />
                                                        <TextBlock Grid.Row="1" Text="仿真类型" Style="{StaticResource SecondaryTextStyle}" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.SelectedProject.SimulationTypeText, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" />
                                                        <TextBlock Grid.Row="2" Text="需求人" Style="{StaticResource SecondaryTextStyle}" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.SelectedProject.RequesterDisplay, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" />
                                                        <TextBlock Grid.Row="3" Text="当前版本" Style="{StaticResource SecondaryTextStyle}" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.SelectedProject.CurrentVersion, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" />
                                                        <TextBlock Grid.Row="4" Text="创建时间" Style="{StaticResource SecondaryTextStyle}" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.SelectedProject.CreatedText, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" />
                                                        <TextBlock Grid.Row="5" Text="开始时间" Style="{StaticResource SecondaryTextStyle}" /><TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind ViewModel.SelectedProject.StartedText, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" />
                                                        <TextBlock Grid.Row="6" Text="最后更新" Style="{StaticResource SecondaryTextStyle}" /><TextBlock Grid.Row="6" Grid.Column="1" Text="{x:Bind ViewModel.SelectedProject.UpdatedText, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" />
                                                        <TextBlock Grid.Row="7" Text="存储位置" Style="{StaticResource SecondaryTextStyle}" /><TextBlock Grid.Row="7" Grid.Column="1" Text="{x:Bind ViewModel.SelectedProject.StorageText, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" />
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="目录路径" Style="{StaticResource CardTitleTextStyle}" />
                                                    <Button x:Name="ProjectPathButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OpenFolder_Click" Style="{StaticResource SecondaryButtonStyle}">
                                                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8B7;" Foreground="#F2A900" /><TextBlock x:Name="ProjectPathText" TextTrimming="CharacterEllipsis" FontSize="13" /></StackPanel>
                                                    </Button>
                                                </StackPanel>
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="快捷操作" Style="{StaticResource CardTitleTextStyle}" />
                                                    <Grid ColumnSpacing="6">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions>
                                                        <Button x:Name="OpenFolderQuickButton" Style="{StaticResource PrimaryButtonStyle}" Click="OpenFolder_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinWidth="0" Padding="6,7"><StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE8B7;" FontSize="14" /><TextBlock Text="打开目录" FontSize="12" /></StackPanel></Button>
                                                        <Button x:Name="SimulationReportQuickButton" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Click="SimulationReport_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinWidth="0" Padding="6,7"><StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE8A5;" FontSize="14" /><TextBlock Text="仿真报告" FontSize="12" /></StackPanel></Button>
                                                        <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Click="EditProject_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinWidth="0" Padding="6,7"><StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE70F;" FontSize="14" /><TextBlock Text="编辑" FontSize="12" /></StackPanel></Button>
                                                        <Button x:Name="MoreActionsButton" Grid.Column="3" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" MinWidth="0" Padding="6" ToolTipService.ToolTip="更多操作">
                                                            <FontIcon Glyph="&#xE712;" FontSize="16" />
                                                            <Button.Flyout>
                                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                                    <MenuFlyoutItem x:Name="ChangeStatusMenuItem" Text="修改状态" Click="ChangeStatus_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                                                    <MenuFlyoutItem x:Name="MigrateMenuItem" Text="迁移" Click="Migrate_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B5;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                                                    <MenuFlyoutItem x:Name="ArchiveMenuItem" Text="归档" Click="Archive_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7B8;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                                                    <MenuFlyoutSeparator />
                                                                    <MenuFlyoutItem Text="删除项目…" Click="DeleteProject_Click" Foreground="#C62828"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                                                </MenuFlyout>
                                                            </Button.Flyout>
                                                        </Button>
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="标签" Style="{StaticResource CardTitleTextStyle}" />
                                                    <TextBlock Text="{x:Bind ViewModel.SelectedProject.TagsText, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabViewItem>
                                    <TabViewItem Header="版本" IsClosable="False">
                                <Grid Padding="8,10"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Button x:Name="NewVersionButton" Content="＋ 创建新版本" Style="{StaticResource PrimaryButtonStyle}" Click="NewVersion_Click" HorizontalAlignment="Left" /><ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Versions, Mode=OneWay}" Margin="0,10,0,0"><ListView.ItemTemplate><DataTemplate x:DataType="models:ProjectVersionRecord"><Grid Padding="6" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock Text="{x:Bind VersionNumber}" FontWeight="SemiBold" /><TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" /><TextBlock Text="{x:Bind ChangeSummary}" TextWrapping="Wrap" Foreground="{ThemeResource SimFlowMutedBrush}" /></StackPanel><Button Grid.Column="1" Content="删除" Click="DeleteVersion_Click" VerticalAlignment="Center" FontSize="12" ToolTipService.ToolTip="删除版本记录，可选将磁盘目录移入恢复区" /></Grid></DataTemplate></ListView.ItemTemplate></ListView></Grid>
                                    </TabViewItem>
                                    <TabViewItem Header="备注" IsClosable="False"><ScrollViewer VerticalScrollBarVisibility="Hidden"><StackPanel Padding="8,14" Spacing="10"><TextBox x:Name="NotesTextBox" Text="{x:Bind ViewModel.SelectedProject.Project.Notes, Mode=OneWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="220" PlaceholderText="记录项目背景、关键决策和待办事项..." /><Button Content="保存备注" Style="{StaticResource PrimaryButtonStyle}" Click="SaveNotes_Click" HorizontalAlignment="Left" /></StackPanel></ScrollViewer></TabViewItem>
                                    <TabViewItem Header="历史" IsClosable="False">
                                        <ListView ItemsSource="{x:Bind ViewModel.Activities, Mode=OneWay}" Padding="8,10"><ListView.ItemTemplate><DataTemplate x:DataType="models:ProjectActivityRecord"><Grid Padding="4,7" ColumnSpacing="9"><Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Ellipse Width="8" Height="8" Fill="#2D73EA" VerticalAlignment="Top" Margin="0,5,0,0" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" /><TextBlock Text="{x:Bind CreatedAt}" FontSize="11" Foreground="{ThemeResource SimFlowMutedBrush}" /></StackPanel></Grid></DataTemplate></ListView.ItemTemplate></ListView>
                                    </TabViewItem>
                                </TabView>
                            </Grid>
                            <StackPanel x:Name="DetailPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"><FontIcon Glyph="&#xE8A5;" FontSize="38" Foreground="{ThemeResource SimFlowMutedBrush}" /><TextBlock Text="选择一个项目查看详情" Foreground="{ThemeResource SimFlowTextSecondaryBrush}" /></StackPanel>
                        </Grid>
                    </Border>
                    <!-- 设置导航：图标卡片与分层文案；保留原有 RadioButton 单选行为。 -->
                    <Border x:Name="SettingsNavPane" Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="12" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="8">
                            <TextBlock Text="设置" Style="{StaticResource SectionTitleTextStyle}" Margin="4,0,0,10" />
                            <RadioButton x:Name="SettingsNavGeneral" Tag="general" GroupName="SettingsNav" Checked="SettingsNav_Checked" IsChecked="True" Style="{StaticResource SettingsNavRadioStyle}" AutomationProperties.Name="常规" AutomationProperties.HelpText="界面与项目封面">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="9" Background="{ThemeResource SimFlowSurfaceSubtleBrush}" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE713;" FontSize="16" Foreground="{ThemeResource SimFlowPrimaryBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="常规" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource SimFlowTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="界面与项目封面" FontSize="11" Foreground="{ThemeResource SimFlowMutedBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="SettingsNavDirectories" Tag="directories" GroupName="SettingsNav" Checked="SettingsNav_Checked" Style="{StaticResource SettingsNavRadioStyle}" AutomationProperties.Name="项目目录" AutomationProperties.HelpText="本机与工作站路径">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="9" Background="{ThemeResource SimFlowSurfaceSubtleBrush}" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource SimFlowPrimaryBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="项目目录" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource SimFlowTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="本机与工作站路径" FontSize="11" Foreground="{ThemeResource SimFlowMutedBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="SettingsNavTags" Tag="tags" GroupName="SettingsNav" Checked="SettingsNav_Checked" Style="{StaticResource SettingsNavRadioStyle}" AutomationProperties.Name="标签" AutomationProperties.HelpText="整理项目分类">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="9" Background="{ThemeResource SimFlowSurfaceSubtleBrush}" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE8EC;" FontSize="16" Foreground="{ThemeResource SimFlowPrimaryBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="标签" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource SimFlowTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="整理项目分类" FontSize="11" Foreground="{ThemeResource SimFlowMutedBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="SettingsNavSoftware" Tag="software" GroupName="SettingsNav" Checked="SettingsNav_Checked" Style="{StaticResource SettingsNavRadioStyle}" AutomationProperties.Name="软件标签" AutomationProperties.HelpText="维护软件名称">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="9" Background="{ThemeResource SimFlowSurfaceSubtleBrush}" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE7F4;" FontSize="16" Foreground="{ThemeResource SimFlowPrimaryBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="软件标签" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource SimFlowTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="维护软件名称" FontSize="11" Foreground="{ThemeResource SimFlowMutedBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="SettingsNavMigration" Tag="migration" GroupName="SettingsNav" Checked="SettingsNav_Checked" Style="{StaticResource SettingsNavRadioStyle}" AutomationProperties.Name="迁移与归档" AutomationProperties.HelpText="存储位置与恢复">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="9" Background="{ThemeResource SimFlowSurfaceSubtleBrush}" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE8B5;" FontSize="16" Foreground="{ThemeResource SimFlowPrimaryBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="迁移与归档" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource SimFlowTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="存储位置与恢复" FontSize="11" Foreground="{ThemeResource SimFlowMutedBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="SettingsNavData" Tag="data" GroupName="SettingsNav" Checked="SettingsNav_Checked" Style="{StaticResource SettingsNavRadioStyle}" AutomationProperties.Name="数据与备份" AutomationProperties.HelpText="扫描与数据恢复">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="9" Background="{ThemeResource SimFlowSurfaceSubtleBrush}" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE8F1;" FontSize="16" Foreground="{ThemeResource SimFlowPrimaryBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="数据与备份" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource SimFlowTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="扫描与数据恢复" FontSize="11" Foreground="{ThemeResource SimFlowMutedBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="SettingsNavHelp" Tag="help" GroupName="SettingsNav" Checked="SettingsNav_Checked" Style="{StaticResource SettingsNavRadioStyle}" AutomationProperties.Name="帮助" AutomationProperties.HelpText="目录规范与说明">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="9" Background="{ThemeResource SimFlowSurfaceSubtleBrush}" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE897;" FontSize="16" Foreground="{ThemeResource SimFlowPrimaryBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="帮助" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource SimFlowTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="目录规范与说明" FontSize="11" Foreground="{ThemeResource SimFlowMutedBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </RadioButton>
                        </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </NavigationView>
        <InfoBar x:Name="StatusInfoBar" IsOpen="False" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="240,12,12,0" MaxWidth="620" IsClosable="True" />
        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <!-- 拖动浮动副本：按住握把后显示这张预先渲染好的卡片图（放大到 CardGhostScale），
             拖动时交给同一个位图作为拖拽视觉，两段用的是同一张图、同一个锚点，因此切换无跳变。
             IsHitTestVisible=False 保证它不抢指针事件；RootGrid 无 Padding，所以它铺满窗口、
             坐标原点与 RootGrid 一致，定位直接用 RootGrid 坐标即可。 -->
        <Canvas x:Name="CardGhostLayer" IsHitTestVisible="False" Visibility="Collapsed">
            <!-- 跟手用 RenderTransform 位移而不是 Canvas.Left/Top：前者不触发布局，每帧成本更低。 -->
            <Image x:Name="CardGhostImage" Stretch="None">
                <Image.RenderTransform>
                    <TranslateTransform />
                </Image.RenderTransform>
            </Image>
        </Canvas>
    </Grid>
</Window>
