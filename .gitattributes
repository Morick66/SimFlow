# 统一 Mac（LF）与 Windows 的换行策略，消除跨平台换行告警。
# 文本文件默认归一化；代码与项目文件显式使用 LF，PowerShell 脚本保留 CRLF；二进制资源不加转换。

* text=auto

*.cs          text eol=lf
*.xaml        text eol=lf
*.csproj      text eol=lf
*.slnx        text eol=lf
*.props       text eol=lf
*.targets     text eol=lf
*.json        text eol=lf
*.xml         text eol=lf
*.manifest    text eol=lf
*.md          text eol=lf
*.txt         text eol=lf
*.gitattributes text eol=lf
*.gitignore   text eol=lf

# Windows 脚本按惯例保留 CRLF
*.ps1         text eol=crlf
*.cmd         text eol=crlf

# 二进制资源
*.png         binary
*.ico         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.bmp         binary
*.db          binary