<?xml version="1.0" encoding="utf-8"?>
<!--
    SimFlow Design Tokens（2026-09-17 UI/UX 重构 Phase 1）
    统一字体层级、颜色（Light/Dark）、圆角、间距、卡片/徽章/按钮样式。
    业务逻辑不在此文件；颜色优先 ThemeResource，标题/正文字号统一引用这里的 x:Double。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ 主题颜色（Light / Dark） ============ -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="SimFlowPageBrush" Color="#F6F8FC" />
            <SolidColorBrush x:Key="SimFlowCardBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SimFlowBorderBrush" Color="#E3E8F0" />
            <SolidColorBrush x:Key="SimFlowTextPrimaryBrush" Color="#0F1C38" />
            <SolidColorBrush x:Key="SimFlowTextSecondaryBrush" Color="#52627A" />
            <SolidColorBrush x:Key="SimFlowMutedBrush" Color="#687792" />
            <SolidColorBrush x:Key="SimFlowPrimaryBrush" Color="#2874F0" />
            <SolidColorBrush x:Key="SimFlowHoverBrush" Color="#F0F4FA" />
            <SolidColorBrush x:Key="SimFlowSelectedBrush" Color="#E6EFFF" />
            <SolidColorBrush x:Key="SimFlowSurfaceSubtleBrush" Color="#EEF2F8" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="SimFlowPageBrush" Color="#17181D" />
            <SolidColorBrush x:Key="SimFlowCardBrush" Color="#1F2127" />
            <SolidColorBrush x:Key="SimFlowBorderBrush" Color="#33363E" />
            <SolidColorBrush x:Key="SimFlowTextPrimaryBrush" Color="#F1F3F7" />
            <SolidColorBrush x:Key="SimFlowTextSecondaryBrush" Color="#B6C0CF" />
            <SolidColorBrush x:Key="SimFlowMutedBrush" Color="#8B95A6" />
            <SolidColorBrush x:Key="SimFlowPrimaryBrush" Color="#3B82F6" />
            <SolidColorBrush x:Key="SimFlowHoverBrush" Color="#262A32" />
            <SolidColorBrush x:Key="SimFlowSelectedBrush" Color="#1E3A5F" />
            <SolidColorBrush x:Key="SimFlowSurfaceSubtleBrush" Color="#23262D" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ============ 字体层级 ============ -->
    <x:Double x:Key="PageTitleFontSize">26</x:Double>
    <x:Double x:Key="SectionTitleFontSize">19</x:Double>
    <x:Double x:Key="CardTitleFontSize">16</x:Double>
    <x:Double x:Key="BodyFontSize">14</x:Double>
    <x:Double x:Key="SecondaryFontSize">12</x:Double>

    <!-- ============ 文本样式 ============ -->
    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource PageTitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource SimFlowTextPrimaryBrush}" />
    </Style>
    <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource SectionTitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource SimFlowTextPrimaryBrush}" />
    </Style>
    <Style x:Key="CardTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource CardTitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource SimFlowTextPrimaryBrush}" />
    </Style>
    <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource SecondaryFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource SimFlowMutedBrush}" />
    </Style>
    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource SimFlowTextSecondaryBrush}" />
    </Style>

    <!-- 保留 RadioButton 的单选/键盘行为，用卡片外观代替表单圆圈。 -->
    <Style x:Key="ChoiceRadioStyle" TargetType="RadioButton">
        <Setter Property="Background" Value="{ThemeResource SimFlowCardBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource SimFlowTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SimFlowBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="ChoiceRoot" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters><Setter Target="ChoiceHover.Opacity" Value="0.4" /></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters><Setter Target="ChoiceRoot.Opacity" Value="0.75" /></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters><Setter Target="ChoiceRoot.Opacity" Value="0.4" /></VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="ChoiceSelection.Opacity" Value="1" />
                                        <Setter Target="ChoicePresenter.Foreground" Value="{ThemeResource SimFlowPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" />
                        <Border x:Name="ChoiceSelection" Background="{ThemeResource SimFlowSelectedBrush}" Opacity="0"
                                BorderBrush="{ThemeResource SimFlowPrimaryBrush}" BorderThickness="1" CornerRadius="{TemplateBinding CornerRadius}"
                                IsHitTestVisible="False" />
                        <Border x:Name="ChoiceHover" Background="{ThemeResource SimFlowHoverBrush}" Opacity="0" Margin="1"
                                CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" />
                        <ContentPresenter x:Name="ChoicePresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTransitions="{TemplateBinding ContentTransitions}" Foreground="{TemplateBinding Foreground}"
                                          FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                                          Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FilterChipRadioStyle" TargetType="RadioButton" BasedOn="{StaticResource ChoiceRadioStyle}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="SettingsNavRadioStyle" TargetType="RadioButton" BasedOn="{StaticResource ChoiceRadioStyle}">
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <!-- ============ 卡片 ============ -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SimFlowCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SimFlowBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <!-- ============ 按钮 ============ -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource SimFlowPrimaryBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- ============ 徽章 / Chip ============ -->
    <Style x:Key="BadgeBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ChipBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SimFlowSurfaceSubtleBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,4" />
    </Style>
    <Style x:Key="ChipTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource SecondaryFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource SimFlowTextSecondaryBrush}" />
    </Style>

    <!-- ============ 行 Hover / Selected（列表） ============ -->
    <Style x:Key="RowHoverBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- ============ 输入控件统一定高 ============ -->
    <Style x:Key="SimFlowTextBoxStyle" TargetType="TextBox">
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
</ResourceDictionary>