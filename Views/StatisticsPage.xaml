<?xml version="1.0" encoding="utf-8"?>
<!--
    统计分析页（SF-038）。
    视觉沿用 SimFlow 现有设计令牌（卡片、圆角、轻边框、蓝色主色），不引入第三方图表库：
    环形图与柱状图都是自绘（环形图在代码里按视图模型给的角度画描边圆弧，柱高由视图模型算好）。
    页面整体纵向滚动；卡片在 3 / 2 / 1 列之间按可用宽度重排，不写死概念图的尺寸。
-->
<UserControl
    x:Class="SimFlow.Views.StatisticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:SimFlow.ViewModels"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- 时间范围按钮：与设置页导航一致的圆角单选，放在页面右上。 -->
        <Style x:Key="RangeRadioStyle" TargetType="RadioButton">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="ChartLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{ThemeResource SimFlowMutedBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <!-- 左侧刻度文字：与网格线同一行、居中压在线上（靠 -7 的负边距把行高让出来）。 -->
        <Style x:Key="AxisLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{ThemeResource SimFlowMutedBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,-7,0,0" />
        </Style>
        <Style x:Key="GridLineStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{ThemeResource SimFlowBorderBrush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="TableHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{ThemeResource SimFlowMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TableCellStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource SimFlowTextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="EmptyHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource SimFlowMutedBrush}" />
            <Setter Property="Margin" Value="0,8,0,4" />
        </Style>
    </UserControl.Resources>

    <Grid SizeChanged="Root_SizeChanged">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Padding="0,16,8,10" Spacing="14">

                <!-- 页头：标题 / 副标题 / 口径说明 / 时间范围。
                     窄宽度下由 ArrangeHeader 把时间范围整块挪到第二行，避免口径说明被挤成一条窄柱。 -->
                <Grid x:Name="HeaderGrid" ColumnSpacing="12" RowSpacing="0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="统计分析" Style="{StaticResource PageTitleTextStyle}" />
                        <TextBlock Text="从数据中了解你的仿真工作分布与项目情况" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                                   Text="统计口径：新建项目按创建时间、完成项目与项目周期按完成时间、进行中 / 等待中 / 已归档为当前快照；软件占比按项目数计算（合计可超 100%）；标签按使用项目数统计。" />
                    </StackPanel>
                    <StackPanel x:Name="RangePanel" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                        <RadioButton x:Name="RangeThisMonth" Content="本月" Tag="CurrentMonth" GroupName="StatisticsRange"
                                     Style="{StaticResource RangeRadioStyle}" Checked="Range_Checked" />
                        <RadioButton x:Name="RangeLastThreeMonths" Content="近 3 个月" Tag="LastThreeMonths" GroupName="StatisticsRange"
                                     Style="{StaticResource RangeRadioStyle}" Checked="Range_Checked" />
                        <RadioButton x:Name="RangeThisYear" Content="今年" Tag="CurrentYear" GroupName="StatisticsRange"
                                     Style="{StaticResource RangeRadioStyle}" Checked="Range_Checked" />
                        <RadioButton x:Name="RangeAll" Content="全部" Tag="All" GroupName="StatisticsRange"
                                     Style="{StaticResource RangeRadioStyle}" Checked="Range_Checked" />
                        <!-- 当前时间范围实际覆盖的窗口：只读展示，不做自定义区间选择。 -->
                        <Border Background="{ThemeResource SimFlowSurfaceSubtleBrush}" CornerRadius="8" Padding="12,7" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.WindowText, Mode=OneWay}" FontSize="12"
                                       Foreground="{ThemeResource SimFlowTextSecondaryBrush}" VerticalAlignment="Center" />
                        </Border>
                        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="18" Height="18"
                                      VerticalAlignment="Center" Margin="4,0,0,0" />
                    </StackPanel>
                </Grid>

                <!-- 顶部概览卡片：只显示真实数量，不编造同比 -->
                <ItemsControl x:Name="KpiRow" ItemsSource="{x:Bind ViewModel.KpiCards, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="220" ItemHeight="96" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:KpiCardViewModel">
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,12" Padding="14,12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="10" VerticalAlignment="Top"
                                            Background="{Binding IconBackground, Converter={StaticResource HexBrushConverter}}">
                                        <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="20"
                                                  Foreground="{Binding AccentColor, Converter={StaticResource HexBrushConverter}}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" FontSize="12" Foreground="{ThemeResource SimFlowTextSecondaryBrush}" />
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <TextBlock Text="{x:Bind Count}" FontSize="25" FontWeight="SemiBold" Foreground="{ThemeResource SimFlowTextPrimaryBrush}" />
                                            <!-- 同比只在能真实算出上一年的同口径区间时显示 -->
                                            <TextBlock Text="{x:Bind TrendText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,0,4"
                                                       Foreground="{Binding TrendColor, Converter={StaticResource HexBrushConverter}}"
                                                       Visibility="{Binding HasTrend, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Footnote}" FontSize="11" Foreground="{ThemeResource SimFlowMutedBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 内容卡片：3 / 2 / 1 列由 ArrangeCards 按宽度重排 -->
                <Grid x:Name="CardsGrid" ColumnSpacing="14" RowSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 仿真类型分布 -->
                    <Border x:Name="SimulationTypeCard" Style="{StaticResource CardBorderStyle}" Padding="16" VerticalAlignment="Stretch">
                        <StackPanel Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="仿真类型分布" Style="{StaticResource CardTitleTextStyle}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SimulationTypeCaption, Mode=OneWay}"
                                           Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                            </Grid>
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid Width="180" Height="180" VerticalAlignment="Center">
                                    <Canvas x:Name="SimulationTypeCanvas" Width="180" Height="180">
                                        <!-- 底圈：没有数据时也能看出这是一张环形图 -->
                                        <Ellipse Canvas.Left="18" Canvas.Top="18" Width="144" Height="144"
                                                 Stroke="{ThemeResource SimFlowSurfaceSubtleBrush}" StrokeThickness="26" />
                                    </Canvas>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.SimulationTypeTotal, Mode=OneWay}" FontSize="30" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" Foreground="{ThemeResource SimFlowTextPrimaryBrush}" />
                                        <TextBlock Text="项目" FontSize="12" HorizontalAlignment="Center" Foreground="{ThemeResource SimFlowMutedBrush}" />
                                    </StackPanel>
                                </Grid>
                                <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.TypeSlices, Mode=OneWay}" VerticalAlignment="Center">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:SimulationTypeSliceViewModel">
                                            <Grid Padding="0,3" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="10" /><ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="48" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center"
                                                        Background="{Binding Color, Converter={StaticResource HexBrushConverter}}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                           Foreground="{ThemeResource SimFlowTextSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind Count}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource SimFlowTextPrimaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{x:Bind PercentageText}" FontSize="12" TextAlignment="Right"
                                                           Foreground="{ThemeResource SimFlowMutedBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Grid.Column="1" Text="所选区间内没有项目" Style="{StaticResource EmptyHintStyle}"
                                           Visibility="{x:Bind ViewModel.HasSimulationTypes, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 每月项目趋势 -->
                    <Border x:Name="TrendCard" Style="{StaticResource CardBorderStyle}" Padding="16" VerticalAlignment="Stretch">
                        <StackPanel Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="每月项目趋势" Style="{StaticResource CardTitleTextStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.TrendCaption, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Border Width="9" Height="9" CornerRadius="2" Background="#2874F0" VerticalAlignment="Center" />
                                        <TextBlock Text="新建项目" FontSize="11" Foreground="{ThemeResource SimFlowMutedBrush}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Border Width="9" Height="9" CornerRadius="2" Background="#22C55E" VerticalAlignment="Center" />
                                        <TextBlock Text="完成项目" FontSize="11" Foreground="{ThemeResource SimFlowMutedBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <!-- 左侧刻度（5 条，含 0） -->
                                <Grid Grid.Column="0" Height="132">
                                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{x:Bind ViewModel.TrendAxis.Top, Mode=OneWay}" Style="{StaticResource AxisLabelStyle}" />
                                    <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.TrendAxis.UpperMiddle, Mode=OneWay}" Style="{StaticResource AxisLabelStyle}" />
                                    <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.TrendAxis.Middle, Mode=OneWay}" Style="{StaticResource AxisLabelStyle}" />
                                    <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.TrendAxis.LowerMiddle, Mode=OneWay}" Style="{StaticResource AxisLabelStyle}" />
                                    <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.TrendAxis.Bottom, Mode=OneWay}" Style="{StaticResource AxisLabelStyle}"
                                               VerticalAlignment="Bottom" Margin="0,0,0,-7" />
                                </Grid>
                                <!-- 右侧：网格线 + 柱子叠放，共用同一份行高保证刻度与柱子对齐 -->
                                <Grid Grid.Column="1" Height="132">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                        <Border Grid.Row="0" Style="{StaticResource GridLineStyle}" />
                                        <Border Grid.Row="1" Style="{StaticResource GridLineStyle}" />
                                        <Border Grid.Row="2" Style="{StaticResource GridLineStyle}" />
                                        <Border Grid.Row="3" Style="{StaticResource GridLineStyle}" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.TrendBars, Mode=OneWay}" HorizontalAlignment="Center">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:TrendBarViewModel">
                                                <Grid Width="{x:Bind SlotWidth}" Height="132">
                                                    <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                                        <Border Width="{x:Bind BarWidth}" Height="{x:Bind CreatedHeight}" Background="#2874F0"
                                                                CornerRadius="3,3,0,0" VerticalAlignment="Bottom" ToolTipService.ToolTip="{x:Bind CreatedTooltip}" />
                                                        <Border Width="{x:Bind BarWidth}" Height="{x:Bind CompletedHeight}" Background="#22C55E"
                                                                CornerRadius="3,3,0,0" VerticalAlignment="Bottom" ToolTipService.ToolTip="{x:Bind CompletedTooltip}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Height="1" VerticalAlignment="Bottom" Background="{ThemeResource SimFlowBorderBrush}" />
                                </Grid>
                            </Grid>
                            <Grid RowSpacing="6">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <ItemsControl Grid.Row="0" ItemsSource="{x:Bind ViewModel.TrendBars, Mode=OneWay}" HorizontalAlignment="Center" Margin="30,0,0,0">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:TrendBarViewModel">
                                            <Grid Width="{x:Bind SlotWidth}"><TextBlock Text="{x:Bind Label}" Style="{StaticResource ChartLabelStyle}" /></Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            <TextBlock Text="所选区间内没有项目" Style="{StaticResource EmptyHintStyle}"
                                       Visibility="{x:Bind ViewModel.HasTrend, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                        </StackPanel>
                    </Border>

                    <!-- 软件使用情况 -->
                    <Border x:Name="SoftwareCard" Style="{StaticResource CardBorderStyle}" Padding="16" VerticalAlignment="Stretch">
                        <StackPanel Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="软件使用情况" Style="{StaticResource CardTitleTextStyle}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SoftwareCaption, Mode=OneWay}"
                                           Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                            </Grid>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.SoftwareUsage, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:SoftwareUsageViewModel">
                                        <Grid Padding="0,4" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" /><ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="26" Height="26" CornerRadius="7" VerticalAlignment="Center"
                                                    Background="{Binding IconBackground, Converter={StaticResource HexBrushConverter}}">
                                                <TextBlock Text="{x:Bind Initial}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{Binding Color, Converter={StaticResource HexBrushConverter}}" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource SimFlowTextSecondaryBrush}" VerticalAlignment="Center" />
                                            <ProgressBar Grid.Column="2" Minimum="0" Maximum="100" Value="{x:Bind Percentage}"
                                                         Height="8" CornerRadius="4" Background="{ThemeResource SimFlowSurfaceSubtleBrush}"
                                                         Foreground="{Binding Color, Converter={StaticResource HexBrushConverter}}"
                                                         VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind CountText}" FontSize="12" MinWidth="72" TextAlignment="Right"
                                                       Foreground="{ThemeResource SimFlowMutedBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="暂无软件使用记录" Style="{StaticResource EmptyHintStyle}"
                                       Visibility="{x:Bind ViewModel.HasSoftwareUsage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                        </StackPanel>
                    </Border>

                    <!-- 需求人排行 -->
                    <Border x:Name="RequesterCard" Style="{StaticResource CardBorderStyle}" Padding="16" VerticalAlignment="Stretch">
                        <StackPanel Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="需求人排行" Style="{StaticResource CardTitleTextStyle}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.RequesterCaption, Mode=OneWay}"
                                           Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                            </Grid>
                            <Grid ColumnSpacing="8" Padding="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="46" /><ColumnDefinition Width="46" /><ColumnDefinition Width="62" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="#" Style="{StaticResource TableHeaderStyle}" />
                                <TextBlock Grid.Column="1" Text="需求人" Style="{StaticResource TableHeaderStyle}" />
                                <TextBlock Grid.Column="2" Text="项目数" Style="{StaticResource TableHeaderStyle}" TextAlignment="Right" />
                                <TextBlock Grid.Column="3" Text="已完成" Style="{StaticResource TableHeaderStyle}" TextAlignment="Right" />
                                <TextBlock Grid.Column="4" Text="进行中" Style="{StaticResource TableHeaderStyle}" TextAlignment="Right" />
                                <TextBlock Grid.Column="5" Text="平均周期" Style="{StaticResource TableHeaderStyle}" TextAlignment="Right" />
                            </Grid>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Requesters, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:RequesterRowViewModel">
                                        <Grid ColumnSpacing="8" Padding="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="46" />
                                                <ColumnDefinition Width="46" /><ColumnDefinition Width="46" /><ColumnDefinition Width="62" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Rank}" Style="{StaticResource TableCellStyle}" Foreground="{ThemeResource SimFlowMutedBrush}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Name}" Style="{StaticResource TableCellStyle}"
                                                       Foreground="{ThemeResource SimFlowTextPrimaryBrush}" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind ProjectCount}" Style="{StaticResource TableCellStyle}" TextAlignment="Right" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind CompletedCount}" Style="{StaticResource TableCellStyle}" TextAlignment="Right" />
                                            <TextBlock Grid.Column="4" Text="{x:Bind ActiveCount}" Style="{StaticResource TableCellStyle}" TextAlignment="Right" />
                                            <TextBlock Grid.Column="5" Text="{x:Bind AverageCycleText}" Style="{StaticResource TableCellStyle}" TextAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="暂无需求人数据" Style="{StaticResource EmptyHintStyle}"
                                       Visibility="{x:Bind ViewModel.HasRequesters, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                        </StackPanel>
                    </Border>

                    <!-- 项目周期分布 -->
                    <Border x:Name="CycleCard" Style="{StaticResource CardBorderStyle}" Padding="16" VerticalAlignment="Stretch">
                        <StackPanel Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="项目周期分布" Style="{StaticResource CardTitleTextStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.CycleNote, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CycleCaption, Mode=OneWay}"
                                           Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                            </Grid>
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Height="126">
                                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{x:Bind ViewModel.CycleAxis.Top, Mode=OneWay}" Style="{StaticResource AxisLabelStyle}" />
                                    <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.CycleAxis.UpperMiddle, Mode=OneWay}" Style="{StaticResource AxisLabelStyle}" />
                                    <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.CycleAxis.Middle, Mode=OneWay}" Style="{StaticResource AxisLabelStyle}" />
                                    <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.CycleAxis.LowerMiddle, Mode=OneWay}" Style="{StaticResource AxisLabelStyle}" />
                                    <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.CycleAxis.Bottom, Mode=OneWay}" Style="{StaticResource AxisLabelStyle}"
                                               VerticalAlignment="Bottom" Margin="0,0,0,-7" />
                                </Grid>
                                <Grid Grid.Column="1" Height="126">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                        <Border Grid.Row="0" Style="{StaticResource GridLineStyle}" />
                                        <Border Grid.Row="1" Style="{StaticResource GridLineStyle}" />
                                        <Border Grid.Row="2" Style="{StaticResource GridLineStyle}" />
                                        <Border Grid.Row="3" Style="{StaticResource GridLineStyle}" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.CycleBuckets, Mode=OneWay}" HorizontalAlignment="Center">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:CycleBarViewModel">
                                                <Grid Width="{x:Bind SlotWidth}" Height="126">
                                                    <Border Width="{x:Bind BarWidth}" Height="{x:Bind BarHeight}" Background="#2874F0"
                                                            CornerRadius="3,3,0,0" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                            ToolTipService.ToolTip="{x:Bind Tooltip}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Height="1" VerticalAlignment="Bottom" Background="{ThemeResource SimFlowBorderBrush}" />
                                </Grid>
                            </Grid>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.CycleBuckets, Mode=OneWay}" HorizontalAlignment="Center" Margin="30,6,0,0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:CycleBarViewModel">
                                        <Grid Width="{x:Bind SlotWidth}"><TextBlock Text="{x:Bind Label}" Style="{StaticResource ChartLabelStyle}" /></Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="暂无可计算周期的已完成项目" Style="{StaticResource EmptyHintStyle}"
                                           Visibility="{x:Bind ViewModel.HasCycleData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                <Button Grid.Column="1" Content="查看全部 →" Click="ViewAll_Click" Tag="completed"
                                        Background="Transparent" BorderThickness="0" Padding="4,2" MinHeight="0" FontSize="12"
                                        Foreground="{ThemeResource SimFlowPrimaryBrush}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 等待时间分析 -->
                    <Border x:Name="WaitCard" Style="{StaticResource CardBorderStyle}" Padding="16" VerticalAlignment="Stretch">
                        <StackPanel Spacing="10">
                            <TextBlock Text="等待时间分析" Style="{StaticResource CardTitleTextStyle}" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{ThemeResource SimFlowSurfaceSubtleBrush}" CornerRadius="10" Padding="12,10">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="累计等待时间" FontSize="11" Foreground="{ThemeResource SimFlowMutedBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.TotalWaitText, Mode=OneWay}" FontSize="18" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource SimFlowTextPrimaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="{ThemeResource SimFlowSurfaceSubtleBrush}" CornerRadius="10" Padding="12,10">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="平均等待时间" FontSize="11" Foreground="{ThemeResource SimFlowMutedBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.AverageWaitText, Mode=OneWay}" FontSize="18" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource SimFlowTextPrimaryBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{ThemeResource SimFlowSurfaceSubtleBrush}" CornerRadius="10" Padding="12,10">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="有等待记录的项目" FontSize="11" Foreground="{ThemeResource SimFlowMutedBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.ProjectsWithWaitCount, Mode=OneWay}" FontSize="18" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource SimFlowTextPrimaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                                       Text="等待时长 = 已完成等待区间之和 + 进行中的等待（按当前时间累计）。" />
                            <!-- 等待原因分布：直接用状态历史里记录的原因字符串（等待下拉框写入），不新增枚举。 -->
                            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasWaitReasons, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{x:Bind ViewModel.WaitReasonCaption, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.WaitReasons, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:WaitReasonViewModel">
                                            <Grid Padding="0,3" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="118" /><ColumnDefinition Width="*" /><ColumnDefinition Width="44" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Reason}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                           Foreground="{ThemeResource SimFlowTextSecondaryBrush}" VerticalAlignment="Center" />
                                                <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{x:Bind PercentageText}"
                                                             Height="8" CornerRadius="4" Foreground="#F59E0B" Background="{ThemeResource SimFlowSurfaceSubtleBrush}"
                                                             VerticalAlignment="Center"
                                                             ToolTipService.ToolTip="{x:Bind CountTooltip}" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind PercentageText}" FontSize="12" TextAlignment="Right"
                                                           Foreground="{ThemeResource SimFlowMutedBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <TextBlock Text="暂无可统计的等待原因" Style="{StaticResource EmptyHintStyle}"
                                       Visibility="{x:Bind ViewModel.HasWaitReasons, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                        </StackPanel>
                    </Border>

                    <!-- 最近完成的项目 -->
                    <Border x:Name="RecentCompletedCard" Style="{StaticResource CardBorderStyle}" Padding="16" VerticalAlignment="Stretch">
                        <StackPanel Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="最近完成的项目" Style="{StaticResource CardTitleTextStyle}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind ViewModel.RecentCompletedCaption, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="查看全部 →" Click="ViewAll_Click" Tag="completed"
                                        Background="Transparent" BorderThickness="0" Padding="4,2" MinHeight="0" FontSize="12"
                                        Foreground="{ThemeResource SimFlowPrimaryBrush}" />
                            </Grid>
                            <Grid ColumnSpacing="10" Padding="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" /><ColumnDefinition Width="106" /><ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="72" /><ColumnDefinition Width="*" /><ColumnDefinition Width="82" /><ColumnDefinition Width="52" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="项目名称" Style="{StaticResource TableHeaderStyle}" />
                                <TextBlock Grid.Column="1" Text="编号" Style="{StaticResource TableHeaderStyle}" />
                                <TextBlock Grid.Column="2" Text="仿真类型" Style="{StaticResource TableHeaderStyle}" />
                                <TextBlock Grid.Column="3" Text="需求人" Style="{StaticResource TableHeaderStyle}" />
                                <TextBlock Grid.Column="4" Text="使用软件" Style="{StaticResource TableHeaderStyle}" />
                                <TextBlock Grid.Column="5" Text="完成时间" Style="{StaticResource TableHeaderStyle}" />
                                <TextBlock Grid.Column="6" Text="周期" Style="{StaticResource TableHeaderStyle}" TextAlignment="Right" />
                            </Grid>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.RecentCompleted, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:RecentCompletedViewModel">
                                        <Grid ColumnSpacing="10" Padding="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" /><ColumnDefinition Width="106" /><ColumnDefinition Width="84" />
                                                <ColumnDefinition Width="72" /><ColumnDefinition Width="*" /><ColumnDefinition Width="82" /><ColumnDefinition Width="52" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource TableCellStyle}"
                                                       Foreground="{ThemeResource SimFlowTextPrimaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ProjectCode}" Style="{StaticResource TableCellStyle}" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind SimulationTypeText}" Style="{StaticResource TableCellStyle}"
                                                       Foreground="{ThemeResource SimFlowPrimaryBrush}" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind RequesterText}" Style="{StaticResource TableCellStyle}" />
                                            <TextBlock Grid.Column="4" Text="{x:Bind SoftwareText}" Style="{StaticResource TableCellStyle}" />
                                            <TextBlock Grid.Column="5" Text="{x:Bind CompletedText}" Style="{StaticResource TableCellStyle}" />
                                            <TextBlock Grid.Column="6" Text="{x:Bind CycleText}" Style="{StaticResource TableCellStyle}" TextAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="所选区间内没有已完成项目" Style="{StaticResource EmptyHintStyle}"
                                       Visibility="{x:Bind ViewModel.HasRecentCompleted, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                        </StackPanel>
                    </Border>

                    <!-- 标签使用频率 TOP 10 -->
                    <Border x:Name="TagCard" Style="{StaticResource CardBorderStyle}" Padding="16" VerticalAlignment="Stretch">
                        <StackPanel Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="标签使用频率 TOP 10" Style="{StaticResource CardTitleTextStyle}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TagCaption, Mode=OneWay}"
                                           Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                            </Grid>
                            <ItemsControl x:Name="TagList" ItemsSource="{x:Bind ViewModel.TopTags, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:TagUsageViewModel">
                                        <Grid ColumnSpacing="10" Padding="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="104" /><ColumnDefinition Width="*" /><ColumnDefinition Width="30" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Name}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource SimFlowTextSecondaryBrush}" VerticalAlignment="Center" />
                                            <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{x:Bind Percentage}"
                                                         Height="10" CornerRadius="5" Foreground="#2874F0" Background="{ThemeResource SimFlowSurfaceSubtleBrush}"
                                                         VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind CountText}" FontSize="12" TextAlignment="Right"
                                                       Foreground="{ThemeResource SimFlowMutedBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="暂无标签数据" Style="{StaticResource EmptyHintStyle}"
                                       Visibility="{x:Bind ViewModel.HasTopTags, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
